{
  "name": "agent-evals",
  "version": "0.1.0",
  "description": "CLI that evaluates local coding-agent sessions with LLM-judge metrics and reports scores plus concrete prompting/execution advice.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-evals": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@letta-ai/trajectory": "0.2.5",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "smol-toml": "^1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
